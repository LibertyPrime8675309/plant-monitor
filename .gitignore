# your live data never goes into the repo
data/*
!data/.gitkeep
backups/*
!backups/.gitkeep
__pycache__/
*.pyc
# release zips are built from the repo, not stored in it
*.zip
dist/
# scratch space for test runs
dev/tmp/
# the Tailscale container's sign-in (1.12.0) and any local settings file: private to each computer
tailscale/state/
.env
backups-copy/
